{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }

    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "4ExplainLogs\\Logs.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter,Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "4EPlatform-StrategicTelecom-Aggregator"
    }
  },
  "RateLimit": {
    "PermitLimit": 5,
    "QueueLimit": 5,
    "WindowSeconds": 10
  },
  "GrpcServiceSettings": {
    "UserManagmentUrl": "http://localhost:7152",
    "ControlPanelAggUrl": "http://localhost:7286",
    "Medal": "http://localhost:7139",
    "Congratulations": "http://localhost:7235",
    "thanks": "http://localhost:5288",
    "orgUrl": "http://57.129.28.127:7286"


  },
  "AllowedHosts": "*",
  "IdentityUrl": "http://localhost:5111/",
  "permesstionUrl": "http://localhost:5111/api/GetControllerAndActionName/AddPermession",
  "ControllerAndActionSkip": [
    {
      "ControllerName": "Thanks",
      "ActionName": [ "GetThanksMessagesByUserId" ]
    }
  ]
}

